generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  email       String              @unique
  password    String
  created_at  DateTime            @default(now())
  role        Role                @default(USER)
  plan        PLAN                @default(FREE)
  aiGenerated AiGenerated[]
  favourites  Favourites[]
  downloads   WallpaperDownload[]
  uploadedWallpapers UploadedWallpapers[]
}

model Favourites {
  id           Int    @id @default(autoincrement())
  userId       Int
  wallpaperId  BigInt
  imageUrl     String
  photographer String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wallpaperId])
}

model WallpaperStats {
  id          Int      @id @default(autoincrement())
  wallpaperId String   @unique
  views       Int      @default(0)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WallpaperDownload {
  id           Int      @id @default(autoincrement())
  userId       Int
  wallpaperId  String?
  createdAt    DateTime @default(now())
  imageUrl     String?
  photographer String
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AiGenerated {
  id        Int      @id @default(autoincrement())
  userId    Int
  prompt    String
  imageUrl  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model UploadedWallpapers{
  id Int @id @default(autoincrement())
  userId Int
  title String
  imageUrl String
  userName String
  imageHash String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum PLAN{
  FREE
  PRO 
  PREMIUM
}
