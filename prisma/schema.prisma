generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique
  email              String               @unique
  password           String
  created_at         DateTime             @default(now())
  role               Role                 @default(USER)
  plan               PLAN                 @default(FREE)
  passwordVersion    Int                  @default(1)
  aiGenerationLimit  Int                  @default(5)
  sessionVerison     Int                  @default(1)
  firstGeneration    DateTime?
  aiGenerated        AiGenerated[]
  favourites         Favourites[]
  downloads          WallpaperDownload[]
  uploadedWallpapers UploadedWallpapers[]
  notification       Notification[]
  likes              Likes[]
  otp                Otp[]
  reports Reports  []
}

model Favourites {
  id           Int      @id @default(autoincrement())
  userId       Int
  wallpaperId  BigInt
  imageUrl     String
  photographer String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  created_at   DateTime @default(now())

  @@unique([userId, wallpaperId])
}

model WallpaperStats {
  id          Int      @id @default(autoincrement())
  wallpaperId String   @unique
  views       Int      @default(0)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WallpaperDownload {
  id           Int      @id @default(autoincrement())
  userId       Int
  wallpaperId  String?
  createdAt    DateTime @default(now())
  imageUrl     String?
  photographer String
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AiGenerated {
  id        Int      @id @default(autoincrement())
  userId    Int
  prompt    String
  imageUrl  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model UploadedWallpapers {
  id           Int            @id @default(autoincrement())
  userId       Int
  title        String
  imageUrl     String
  userName     String
  imageHash    String         @unique
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id])
  likes        Likes[]
  notification Notification[]
  reports Reports[]

  @@unique([id, userId])
  @@index([userId])
}

model Likes {
  id           Int                @id @default(autoincrement())
  userId       Int
  postId       Int
  created_at   DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploads      UploadedWallpapers @relation(fields: [postId], references: [id], onDelete: Cascade)
  notification Notification[]

  @@unique([userId, postId])
}

model Notification {
  id         Int                @id @default(autoincrement())
  ownerId    Int
  imageUrl   String
  postId     Int
  userName   String
  created_at DateTime           @default(now())
  user       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post       UploadedWallpapers @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes      Likes?             @relation(fields: [likesId], references: [id])
  likesId    Int?
}

model Otp {
  id         Int      @id @default(autoincrement())
  userId     Int
  otpHash    String
  expiresAt  DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reports {
  id          Int    @id @default(autoincrement())
  reporterId  Int  
  postId      Int
  category    ReportCategory @default(OTHER)
  description String
  status      Status @default(PENDING)
  user       User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  post UploadedWallpapers @relation(fields: [postId], references:[id], onDelete:Cascade)
   @@unique([postId, reporterId])
}

enum ReportCategory {
  INAPPROPRIATE_CONTENT
  COPYRIGHT_VIOLATION
  LOW_QUALITY
  MISLEADING
  SPAM
  HATE_SPEECH
  OTHER
}

enum Status {
  PENDING
  RESOLVED
  UNDER_REVIEW
  DISMISSED
}

enum Role {
  USER
  ADMIN
}

enum PLAN {
  FREE
  PRO
  PREMIUM
}
